export async function GET() {
  try {
    console.log("正在嘗試連線至 MongoDB...");
    await connectToDatabase();

    // 確認目前連到的資料庫名稱
    const currentDb = mongoose.connection.name;
    console.log(`目前連線的資料庫是: ${currentDb}`);

    // 1. 清理舊資料（避免重複，這樣你重跑幾次都沒關係）

    console.log("原始資料筆數:", jsonData.length);

    const dataToProcess = jsonData[0].highways;

    const cleanedData = dataToProcess.map((highway: any) => {
      const idStr = highway.id.toString();
      const paths = photoPaths[idStr as keyof typeof photoPaths] || [];
      const notes = photoNotes[idStr as keyof typeof photoNotes] || [];

      // 將路徑與敘述配對，並抽離日期
      const images = paths.map((url, index) => {
        const fullNote = notes[index] || "";

        // 正則表達式：尋找結尾的 YYYY.MM.DD 或 YYYY.M.D
        const dateMatch = fullNote.match(/(\d{4}\.\d{1,2}\.\d{1,2})$/);
        const capturedAt = dateMatch
          ? new Date(dateMatch[1].replace(/\./g, "-"))
          : undefined;

        // 移除敘述中的日期部分，保持敘述乾淨
        const description = fullNote
          .replace(/\s?\d{4}\.\d{1,2}\.\d{1,2}$/, "")
          .trim();

        return {
          url,
          description,
          capturedAt: capturedAt || new Date(),
        };
      });
      return {
        id: Number(highway.id),
        name: highway.name,
        routeName: highway.routeName,

        // 里程處理
        length: highway.length ? parseFloat(highway.length) : 0,
        currentLength: highway.currentLength
          ? parseFloat(highway.currentLength)
          : undefined,

        // 起迄點處理
        start: highway.start,
        currentStart: highway.currentStart || undefined, // 如果沒有就設為 undefined
        end: highway.end,
        currentEnd: highway.currentEnd || undefined,

        // 其他資訊
        otherName: highway.otherName ? highway.otherName.split("、") : [],
        highest: highway.highest ? parseInt(highway.highest) : 0,
        highestPlace: highway.highestPlace,
        remark: highway.remark || undefined, // 備註欄位也補上

        // 剛才縫合好的圖片陣列
        images: images,
      };
    });

    // 偵錯：在終端機印出第一筆資料的圖片數量
    console.log(`準備匯入 ${cleanedData.length} 筆公路資料`);
    console.log(
      `第一筆資料 (${cleanedData[0].name}) 的圖片數:`,
      cleanedData[0].images.length,
    );
    console.log("正在清理舊有的公路資料...");
    await Highway.deleteMany({});
    console.log("清洗後的資料筆數:", cleanedData.length);

    // 4. 執行遷移
    console.log(`正在匯入 ${cleanedData.length} 筆資料...`);
    const result = await Highway.insertMany(cleanedData);

    return NextResponse.json({
      message: "🎉 資料遷移成功！",
      database: currentDb,
      count: result.length,
      data: result,
      sampleImages: result[0].images,
    });
  } catch (error: any) {
    console.error("遷移失敗，錯誤詳情:", error);
    return NextResponse.json(
      {
        error: "遷移失敗",
        details: error.message,
      },
      { status: 500 },
    );
  }
}
